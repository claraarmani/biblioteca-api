{
  "info": {
    "_postman_id": "40bc9b88-e17c-4586-abfa-c14a78579cb8",
    "name": "Projeto API - Loja de Roupas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52903286"
  },
  "item": [
    {
      "name": "Cadastrar leitor",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/leitores",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Leitor\",\"email\":\"{{$randomEmail}}\",\"turma\":\"1A\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cadastro concluído', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('leitorId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar empréstimo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/emprestimos",
        "body": {
          "mode": "raw",
          "raw": "{\"nomeLivro\":\"Dom Casmurro\",\"leitorId\":{{leitorId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cadastro concluído', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('emprestimoId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar empréstimos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/emprestimos"
      }
    },
    {
      "name": "Buscar empréstimo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/emprestimos/{{emprestimoId}}"
      }
    },
    {
      "name": "Testar ID inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/emprestimos/abc"
      }
    },
    {
      "name": "Atualizar empréstimo",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/emprestimos/{{emprestimoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"dataDevolucao\":\"2026-12-01\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Excluir empréstimo",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/emprestimos/{{emprestimoId}}"
      }
    },
    {
      "name": "Testar cadastro inválido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/emprestimos",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
