{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"WEB,API\" -c \"cyan,green\" \"npm run dev -w @bibapi/server\" \"npm run dev -w @bibapi/client\"",
    "server-dev": "npm run dev -w @bibapi/server",
    "back-dev": "npm run server-dev",
    "front-dev": "npm run client-dev",
    "start": "npm run start -w @bibapi/server",
    "generate": "npm run generate -w @bibapi/storage",
    "migrate-dev": "npm run migrate-dev -w @bibapi/storage",
    "migrate-reset": "npm run migrate-reset -w @bibapi/storage",
    "studio": "npm run studio -w @bibapi/storage",
    "client-dev": "npm run dev -w @bibapi/client -- --port 3001",
    "build": "npm run build -w @bibapi/client",
    "seed": "npm run seed -w @bibapi/storage"
  },
  "overrides": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prisma": "^7.0.0",
    "nodemon": "3.1.11",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}