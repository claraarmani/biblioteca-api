{
  "name": "@bibapi/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/storage/src/lib --watch ../../packages/storage/src/index.js --exec \"node --env-file-if-exists=../../.env\" src/index.js",
    "start": "node --env-file-if-exists=../../.env src/index.js",
    "seed": "npm run seed -w @bibapi/storage"
  },
  "dependencies": {
    "@bibapi/storage": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "3.1.11"
  }
}
